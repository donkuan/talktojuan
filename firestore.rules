rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The two travellers. Replace the two addresses with the emails you sign up with, in lower case.
    function traveller() {
      return request.auth != null
        && request.auth.token.email in ['kuanchung@live.nl', 'mirnabosnjak@hotmail.com'];
    }
    // Each signed-in user can read and write only their own data
    // (Talk to Juan progress, private word list, trip packing list).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Talk to Juan: the shared word list.
    match /shared/{doc} {
      allow read, write: if traveller();
    }
    // Trip planner: bookings, tickets, stars and edited days, shared by the two travellers only.
    match /trip/{rest=**} {
      allow read, write: if traveller();
    }
  }
}
