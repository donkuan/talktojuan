rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own progress (and private word list).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // The shared word list (from your own copy of the dictionary): only the listed travellers.
    // Replace the two addresses with the emails you sign up with, in lower case.
    match /shared/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['traveller1@example.com', 'traveller2@example.com'];
    }
  }
}
